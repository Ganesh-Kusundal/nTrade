            # event source (live IST-aware ticks, naive-IST history bars).
            ts = ts.replace(tzinfo=IST).astimezone(timezone.utc).replace(tzinfo=None)
        epoch = int(ts.timestamp())
        return epoch - (epoch % self.seconds)
